# ── Backend Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Port the server listens on (Render auto-assigns this in production)
PORT=5000

# Runtime environment: development | production
NODE_ENV=development

# Log verbosity: debug | info | warn | error
# Use "debug" locally to see score breakdowns and cache hits.
# Use "info" in production.
LOG_LEVEL=debug

# CORS: allowed frontend origin
# Set to your Vercel URL in production, e.g. https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
